# Anthropic credentials, for the photo analysis. Either set the key here, or run
# `ant auth login` and leave this unset — the SDK resolves the stored profile.
ANTHROPIC_API_KEY=

# Shared passcode for the whole deployment. Set this whenever the app is on a
# public URL; leave it blank on localhost and the app is open.
KILO_PASSCODE=

# Where the food log and photos live. Defaults to ./data — set to the mount
# point when running in a container (the Dockerfile uses /data).
# KILO_DATA_DIR=./data

# Which model analyses the photos. Defaults to claude-opus-5. Cheaper options
# are claude-sonnet-5 and claude-haiku-4-5 — measure with `npm run eval` before
# switching, since accuracy is the whole point.
# KILO_MODEL=claude-sonnet-5
